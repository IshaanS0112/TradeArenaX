# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local config. .env.example is committed; .env is never.
.env
.env.*
!.env.example

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/

# TypeScript incremental build cache. Written by `tsc -b`, contains absolute
# paths and timestamps from the machine that built it, and is regenerated on
# every build - so committing it produces pointless diffs and merge conflicts.
*.tsbuildinfo

# Local databases produced by the test suite
*.db
*.sqlite
*.sqlite3

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
