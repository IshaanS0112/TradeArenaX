# Copy to .env. Every value here changes a simulation result, so a run is only
# reproducible together with the settings that produced it - which is why the
# resolved set is written into simulations.engine_config on every run.

DATABASE_URL=postgresql+psycopg2://trade:trade@localhost:5432/tradearenax
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Microstructure ---
TICK_SIZE=0.01
MIN_ORDER_QUANTITY=1.0
MAX_SIMULATION_STEPS=20000
SELF_TRADE_PREVENTION=CANCEL_RESTING

# --- Fees, in basis points of notional ---
# Zero by default so the zero-sum PnL identity holds exactly. Set TAKER_FEE_BPS
# to something like 1.0 to see market-making economics behave realistically:
# the passive side earns the spread, the aggressive side pays for immediacy.
MAKER_FEE_BPS=0.0
TAKER_FEE_BPS=0.0

# --- Risk accounting ---
# capital_base is the denominator of every return, and therefore of Sharpe and
# of drawdown. steps_per_year is the annualisation factor; the default assumes
# one step is one minute of a US equity session (252 days x 390 minutes).
CAPITAL_BASE=100000.0
RISK_FREE_RATE_ANNUAL=0.0
STEPS_PER_YEAR=98280
LIQUIDATION_FRACTION=0.5
